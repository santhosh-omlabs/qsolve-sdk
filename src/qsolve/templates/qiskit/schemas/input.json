{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["Q"],
  "additionalProperties": false,
  "properties": {
    "Q": {
      "title": "QUBO matrix",
      "description": "Square matrix Q; the workflow minimises x'Qx over 0/1 variables",
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": {"type": "array", "items": {"type": "number"}},
      "x-ui": {"widget": "matrix", "labels_from": "labels", "symmetric": true}
    },
    "labels": {
      "title": "Variable names",
      "description": "Optional names for the variables, in order",
      "type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 32}
    }
  }
}
